# ---------------------------------------------------------------------------
# TheWed — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
PORT=3000
# Public base URL of the deployed app (used to build magic links + invitation URLs).
# LOCAL: http://localhost:3000
# PRODUCTION (Railway): set this to your real domain, e.g. https://www.zenvite.online
# Magic links then become https://www.zenvite.online/edit/<token>
# and public invites become https://www.zenvite.online/i/<groom-bride>
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL — Railway)
# Railway provides DATABASE_URL. Locally you can use it too, or the discrete vars.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/thewed
# When connecting to Railway (or any managed PG requiring SSL) set this to true.
DATABASE_SSL=false

# ---------------------------------------------------------------------------
# Admin credentials
# The admin panel uses HTTP Basic-style auth. Set a username and either a
# bcrypt hash (preferred) or a plaintext password (dev only).
# Generate a hash: node -e "console.log(require('bcryptjs').hashSync('yourpass',10))"
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# ADMIN_PASSWORD_HASH=$2a$10$....   # if set, takes precedence over ADMIN_PASSWORD
# Secret used to sign the admin session cookie
ADMIN_SESSION_SECRET=please-change-this-long-random-string

# ---------------------------------------------------------------------------
# Email via Google Apps Script web app
# Deploy the script in docs/appscript-email.gs as a Web App ("Anyone" access),
# then paste its /exec URL here. Requests are POSTed with { to, subject, html }.
# EMAIL_SHARED_SECRET must match the SHARED_SECRET inside the Apps Script.
# ---------------------------------------------------------------------------
GOOGLE_APPSCRIPT_EMAIL_URL=
EMAIL_SHARED_SECRET=
EMAIL_FROM_NAME=TheWed

# ---------------------------------------------------------------------------
# Image storage
# Two backends are supported. Firebase is PREFERRED (couples upload their own
# images); Google Drive is a legacy fallback. If Firebase is configured it is
# used; otherwise Drive is used. Existing invitations that stored Drive URLs
# keep working regardless of which backend is active.
# ---------------------------------------------------------------------------

# --- Firebase Cloud Storage (preferred) ---
# 1. In the Firebase console create/pick a project, open Storage, and note the
#    bucket name (e.g. my-project.appspot.com or my-project.firebasestorage.app).
# 2. Project settings > Service accounts > "Generate new private key".
# 3. Provide that key JSON as a single string in FIREBASE_SERVICE_ACCOUNT_JSON
#    (or a path to the file in FIREBASE_APPLICATION_CREDENTIALS), and set the
#    bucket in FIREBASE_STORAGE_BUCKET.
# Uploaded objects are made public so they embed directly in the invitation.
FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json
FIREBASE_STORAGE_BUCKET=

# --- Google Drive (legacy fallback — leave blank if using Firebase) ---
# Create a service account, enable the Drive API, share a parent folder with
# the service account email. Provide credentials as a single JSON string
# (GOOGLE_SERVICE_ACCOUNT_JSON) or a path to the key file (GOOGLE_APPLICATION_CREDENTIALS).
# GOOGLE_DRIVE_PARENT_FOLDER_ID is the folder under which per-invitation folders are made.
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# ---------------------------------------------------------------------------
# Bank transfer details shown to customers after they place an order.
# These are only DEFAULTS — an admin can edit them at runtime in the admin
# panel (Bank Settings tab); saved values are stored in the DB and take
# precedence over these. Template prices are likewise editable in the admin
# panel (Templates & Prices tab).
# ---------------------------------------------------------------------------
BANK_NAME=Bank of Ceylon
BANK_ACCOUNT_NAME=TheWed (Pvt) Ltd
BANK_ACCOUNT_NUMBER=0000000000
BANK_BRANCH=Colombo
BANK_SWIFT=BCEYLKLX
